# Leave everything blank for local dev — the app falls back to a local
# SQLite-compatible file (data/content.db) and local disk uploads, no
# accounts needed.
#
# Fill these in only when deploying somewhere without a persistent local
# disk (e.g. Render's free tier). See README.md for where to get each value.

# Turso (https://turso.tech) — free SQLite-compatible hosted database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudinary (https://cloudinary.com) — free image hosting for inspo screenshots
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set automatically by most hosts (Render, Fly, etc.) — override only if needed
PORT=3002
